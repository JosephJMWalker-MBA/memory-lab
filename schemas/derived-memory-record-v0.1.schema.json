{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/memory-lab/derived-memory-record-v0.1.schema.json",
  "title": "Experimental Derived Memory Record v0.1",
  "description": "Adversarial refinement of derived-memory v0. Adds qualifiers, recursive derivation provenance, and separate valid-time / knowledge-time semantics. Synthetic public research only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "record_id",
    "record_type",
    "subject",
    "predicate",
    "object",
    "qualifiers",
    "evidence_refs",
    "derived_from_records",
    "source_snapshot_id",
    "status",
    "change_kind",
    "attribution_check",
    "knowledge_time"
  ],
  "properties": {
    "schema": {
      "const": "derived-memory-record-v0.1"
    },
    "record_id": {
      "type": "string",
      "pattern": "^DM-[0-9a-f]{16}$"
    },
    "record_type": {
      "enum": [
        "fact",
        "state",
        "relationship",
        "event",
        "principle",
        "temporal_transition"
      ]
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "predicate": {
      "type": "string",
      "minLength": 1
    },
    "object": {
      "type": "string",
      "minLength": 1
    },
    "qualifiers": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^EV-[A-Z0-9-]+$"
      },
      "uniqueItems": true
    },
    "derived_from_records": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^DM-[0-9a-f]{16}$"
      },
      "uniqueItems": true
    },
    "source_snapshot_id": {
      "type": "string",
      "pattern": "^SYN-DM-[0-9]{4}$"
    },
    "status": {
      "enum": [
        "proposed",
        "verified",
        "rejected",
        "superseded",
        "unresolved"
      ]
    },
    "change_kind": {
      "enum": [
        "initial",
        "evidence_added",
        "world_state_changed",
        "interpretation_changed",
        "conflict_detected"
      ]
    },
    "attribution_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "checked_evidence_refs",
        "checked_derived_records",
        "reason_code",
        "note"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "not_checked",
            "supported",
            "revised",
            "rejected",
            "unresolved"
          ]
        },
        "checked_evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^EV-[A-Z0-9-]+$"
          },
          "uniqueItems": true
        },
        "checked_derived_records": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^DM-[0-9a-f]{16}$"
          },
          "uniqueItems": true
        },
        "reason_code": {
          "enum": [
            "not_checked",
            "direct_support",
            "corroborated_support",
            "overreach",
            "conflicting_evidence",
            "explicit_correction",
            "temporal_update",
            "qualifier_loss",
            "recursive_support",
            "retroactive_correction"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "valid_time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            }
          ]
        },
        "to": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            }
          ]
        }
      }
    },
    "knowledge_time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "first_known_snapshot",
        "last_assessed_snapshot"
      ],
      "properties": {
        "first_known_snapshot": {
          "type": "string",
          "pattern": "^SYN-DM-[0-9]{4}$"
        },
        "last_assessed_snapshot": {
          "type": "string",
          "pattern": "^SYN-DM-[0-9]{4}$"
        }
      }
    },
    "supersedes": {
      "$ref": "#/$defs/recordIds"
    },
    "superseded_by": {
      "$ref": "#/$defs/recordIds"
    },
    "contradicts": {
      "$ref": "#/$defs/recordIds"
    },
    "qualifies": {
      "$ref": "#/$defs/recordIds"
    },
    "revision_of": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^DM-[0-9a-f]{16}$"
        }
      ]
    },
    "derivation_rule": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    }
  },
  "$defs": {
    "recordIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^DM-[0-9a-f]{16}$"
      },
      "uniqueItems": true
    }
  }
}
