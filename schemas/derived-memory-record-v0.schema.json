{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/memory-lab/derived-memory-record-v0.schema.json",
  "title": "Experimental Derived Memory Record v0",
  "description": "Experimental public research contract reproduced only by synthetic derived-memory tests. It is not a recovered implementation format and is not production-ready.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "record_id", "record_type", "subject", "predicate", "object",
    "evidence_refs", "source_snapshot_id", "status", "change_kind", "attribution_check"
  ],
  "properties": {
    "schema": {"const": "derived-memory-record-v0"},
    "record_id": {"type": "string", "pattern": "^DM-[0-9a-f]{16}$"},
    "record_type": {"enum": ["fact", "state", "relationship", "event", "principle", "temporal_transition"]},
    "subject": {"type": "string", "minLength": 1},
    "predicate": {"type": "string", "minLength": 1},
    "object": {"type": "string", "minLength": 1},
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^EV-[A-Z0-9-]+$"},
      "uniqueItems": true
    },
    "source_snapshot_id": {"type": "string", "pattern": "^SYN-DM-[0-9]{4}$"},
    "status": {"enum": ["proposed", "verified", "rejected", "superseded", "unresolved"]},
    "change_kind": {"enum": ["initial", "evidence_added", "world_state_changed", "interpretation_changed", "conflict_detected"]},
    "attribution_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "checked_evidence_refs", "reason_code", "note"],
      "properties": {
        "outcome": {"enum": ["not_checked", "supported", "revised", "rejected", "unresolved"]},
        "checked_evidence_refs": {
          "type": "array",
          "items": {"type": "string", "pattern": "^EV-[A-Z0-9-]+$"},
          "uniqueItems": true
        },
        "reason_code": {"enum": ["not_checked", "direct_support", "corroborated_support", "overreach", "conflicting_evidence", "explicit_correction", "temporal_update"]},
        "note": {"type": "string", "minLength": 1}
      }
    },
    "temporal_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_snapshot", "end_snapshot"],
      "properties": {
        "start_snapshot": {"type": "string", "pattern": "^SYN-DM-[0-9]{4}$"},
        "end_snapshot": {
          "anyOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^SYN-DM-[0-9]{4}$"}
          ]
        }
      }
    },
    "supersedes": {"$ref": "#/$defs/recordIds"},
    "superseded_by": {"$ref": "#/$defs/recordIds"},
    "contradicts": {"$ref": "#/$defs/recordIds"},
    "qualifies": {"$ref": "#/$defs/recordIds"},
    "revision_of": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^DM-[0-9a-f]{16}$"}
      ]
    }
  },
  "$defs": {
    "recordIds": {
      "type": "array",
      "items": {"type": "string", "pattern": "^DM-[0-9a-f]{16}$"},
      "uniqueItems": true
    }
  }
}
