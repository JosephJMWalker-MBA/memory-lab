@prefix ml: <https://example.org/memory-lab/export/> .
@prefix prof: <https://example.org/gie-profile/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .

# O1, violation, motivating.
# Source: appstate-baseline-v0, design B2 (recompute-on-read), after the rule-v2
# probe (issue #13).
#
# The system recomputes the 0200 view with rule v2 and never recorded the 0200
# conclusion "Helios blocked". A faithful export therefore holds only the
# recomputed projection. The lost conclusion is an absence.

ml:o1VegaBlockedRecord a prov:Entity .
ml:o1EvidenceSet a prov:Entity .
ml:o1Agent a prov:SoftwareAgent .
ml:o1RuleV2 a prov:Plan .

ml:o1Coverage
    a dqv:QualityMeasurement, prov:Entity ;
    dqv:isMeasurementOf prof:relevantEvidenceCoverage ;
    dqv:computedOn ml:o1EvidenceSet ;
    dqv:value "unknown" .

ml:o1Recompute
    a prov:Activity ;
    prov:used ml:o1VegaBlockedRecord, ml:o1Coverage ;
    prov:qualifiedAssociation [ a prov:Association ; prov:agent ml:o1Agent ; prov:hadPlan ml:o1RuleV2 ] ;
    prov:generated ml:o1VegaProjection .

ml:o1VegaProjection
    a prov:Entity ;
    prof:currentViewDisposition prof:admitted ;
    prov:wasGeneratedBy ml:o1Recompute ;
    prov:wasDerivedFrom ml:o1VegaBlockedRecord .
