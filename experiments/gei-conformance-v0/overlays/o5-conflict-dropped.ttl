@prefix ml: <https://example.org/memory-lab/export/> .
@prefix prof: <https://example.org/gie-profile/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .

# O5, violation, motivating.
# Source: appstate-baseline-v0 design B0, and graphiti-conflict-v0 native
# resolution (issues #11 and #13).
#
# Both Polaris claims were supported, but the design kept only one. The blocked
# record exists and has no projection, so the conflict is no longer visible.

ml:o5BlockedRecord a prov:Entity .
ml:o5ReadyRecord a prov:Entity .
ml:o5EvidenceSet a prov:Entity .
ml:o5Agent a prov:SoftwareAgent .
ml:o5PrecedencePolicy a prov:Plan .

ml:o5Coverage
    a dqv:QualityMeasurement, prov:Entity ;
    dqv:isMeasurementOf prof:relevantEvidenceCoverage ;
    dqv:computedOn ml:o5EvidenceSet ;
    dqv:value "unknown" .

ml:o5Decision
    a prov:Activity ;
    prov:used ml:o5ReadyRecord, ml:o5Coverage ;
    prov:qualifiedAssociation [ a prov:Association ; prov:agent ml:o5Agent ; prov:hadPlan ml:o5PrecedencePolicy ] ;
    prov:generated ml:o5ReadyProjection .

ml:o5ReadyProjection
    a prov:Entity ;
    prof:currentViewDisposition prof:admitted ;
    prov:wasGeneratedBy ml:o5Decision ;
    prov:wasDerivedFrom ml:o5ReadyRecord .
